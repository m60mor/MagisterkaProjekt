  <tag k="colour" v="green"/>
  <tag k="comment" v="W Gliwicach szlak nie był odnawiany od czasu budowy A4 i DTŚ. Poruszanie się w tym rejonie jest możliwe pobliskimi drogami, ale nie oryginalnym przebiegiem. Przejście przez ruchliwą Mikołowską w Tychach jest trudne, lepiej dojść do świateł."/>
  <tag k="distance" v="77.9"/>
  <tag k="from" v="Gliwice"/>
  <tag k="name" v="Szlak Krawędziowy GOP"/>
  <tag k="network" v="rwn"/>
  <tag k="note" v="Poprzednio szlak prowadził drogami leśnymi i do przebiegania przez czteropasmową Beskidzką. Przebieg został zmieniony, ale w kluczowych punktach brakuje oznakowania. Uwaga szczególnie na skręt na lędzińskim Zamoścu."/>
  <tag k="operator" v="PTTK"/>
  <tag k="osmc:symbol" v="green:white:green_bar"/>
  <tag k="ref" v="SL-240-z/MP-240-z"/>
  <tag k="route" v="hiking"/>
  <tag k="to" v="Chełmek (kiedyś Jaworzsno-Stawy Belnik, Tarka)"/>
  <tag k="type" v="route"/>
 </relation>
